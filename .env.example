# Copy this file to .env (same folder you run litsurvey from) and fill in your keys.
# .env is git-ignored, so the keys never get committed.

# Needed for --llm anthropic  (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
# Only for org-level keys not scoped to a workspace
# ANTHROPIC_WORKSPACE_ID=

# Needed for --sources ...,scopus  (dev.elsevier.com)
SCOPUS_API_KEY=
# Optional institutional token if you're off campus
# SCOPUS_INSTTOKEN=

# Optional
# OPENAI_API_KEY=
# S2_API_KEY=
# OPENALEX_EMAIL=
